# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Only needed when USE_LLM_NORMALIZATION=true
MISTRAL_API_KEY=your_key_here

# Optional: turn on the LLM label-normalization pass (deterministic
# parser runs either way)
USE_LLM_NORMALIZATION=false
MISTRAL_MODEL=mistral-small-2506

# Optional overrides
# BHA_DB_PATH=/absolute/path/bha.db
# BHA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
